# AwesomeAPI (optional — without key, cache TTL is 1min; with key, 15min)
AWESOMEAPI_KEY=

# Groq / LLM
GROQ_API_KEY=your_groq_api_key
GROQ_MODEL=openai/gpt-oss-120b

# Google OAuth (Google Cloud Console → OAuth 2.0 Client → "CRM+ Helpdesk AI Portfolio")
# Redirect URI must be: https://crm.felbatista.tech/api/v1/auth/callback
GOOGLE_CLIENT_ID=your_google_client_id
GOOGLE_CLIENT_SECRET=your_google_client_secret

# Session
SESSION_TTL_SECONDS=604800

# Database (Postgres)
DATABASE_URL=postgresql+asyncpg://postgres:123@postgres:5432/postgres

# Redis
REDIS_URL=redis://redis:6379/0

# App
SECRET_KEY=change-me-in-production
APP_ENV=production
FRONTEND_ORIGIN=https://crm.felbatista.tech

# Sentry (optional)
SENTRY_DSN=
